# URL da API Java do SafeMove.
# iOS (simulador) / web: http://localhost:8080
# Emulador Android:      http://10.0.2.2:8080
# Celular físico (Expo Go): http://<IP-do-seu-computador-na-rede>:8080
EXPO_PUBLIC_API_URL=http://localhost:8080

# true = usa os dados de exemplo de src/mocks para demonstrar sem a API
EXPO_PUBLIC_USE_MOCK=true
